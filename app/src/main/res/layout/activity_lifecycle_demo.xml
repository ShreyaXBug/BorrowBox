<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp" android:background="@color/background">
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Activity Lifecycle" android:textColor="@color/text_primary" android:textSize="26sp" android:textStyle="bold"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="The log below updates as this activity moves through its lifecycle." android:textColor="@color/text_secondary"/>
 <TextView android:id="@+id/lifecycleLog" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="14dp" android:background="@drawable/bg_card" android:padding="14dp" android:textColor="@color/text_primary" android:textSize="14sp"/>
</LinearLayout>
