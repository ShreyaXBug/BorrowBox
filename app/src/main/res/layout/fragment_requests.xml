<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="30dp">

        <!-- Header -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="40dp"
            android:text="My Requests"
            android:textColor="#29242B"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="5dp"
            android:text="Track your borrowing activity"
            android:textColor="#817681"
            android:textSize="15sp" />

        <!-- Pending -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="30dp"
            android:text="Pending"
            android:textColor="#29242B"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="24dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Book -->

            <TextView
                android:id="@+id/requestBook"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No requests yet"
                android:textColor="#29242B"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Owner -->

            <TextView
                android:id="@+id/requestOwner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="#817681"
                android:textSize="14sp" />

            <!-- Message -->

            <TextView
                android:id="@+id/requestMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Your borrowing requests will appear here."
                android:textColor="#817681"
                android:textSize="14sp" />

            <!-- Status -->

            <TextView
                android:id="@+id/requestStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text=""
                android:textColor="#B07838"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>