<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp" android:background="@color/background">
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Intent Lab" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Explicit and implicit intents used by BorrowBox." android:textColor="@color/text_secondary"/>
 <Button android:id="@+id/explicitBtn" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="18dp" android:text="Explicit: Open Book Details" android:textAllCaps="false"/>
 <Button android:id="@+id/shareBtn" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="Implicit: Share text" android:textAllCaps="false"/>
 <Button android:id="@+id/webBtn" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="Implicit: Open website" android:textAllCaps="false"/>
 <Button android:id="@+id/emailBtn" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="Implicit: Compose email" android:textAllCaps="false"/>
 <Button android:id="@+id/shareReceivedBtn" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="Open Share Receiver" android:textAllCaps="false"/>
</LinearLayout>
