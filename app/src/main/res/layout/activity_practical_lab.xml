<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Android Practical Lab" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Hands-on demonstrations built into BorrowBox" android:textColor="@color/text_secondary" android:textSize="13sp" />
        <Button android:id="@+id/lifecycleBtn" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="18dp" android:text="Activity Lifecycle" android:textAllCaps="false" />
        <Button android:id="@+id/layoutBtn" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Layouts + UI Components" android:textAllCaps="false" />
        <Button android:id="@+id/fragmentBtn" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Fragments (Horizontal + Vertical)" android:textAllCaps="false" />
        <Button android:id="@+id/intentBtn" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Explicit + Implicit Intents" android:textAllCaps="false" />
        <Button android:id="@+id/cameraBtn" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Camera" android:textAllCaps="false" />
        <Button android:id="@+id/sqliteBtn" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="SQLite CRUD" android:textAllCaps="false" />
        <Button android:id="@+id/smsBtn" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="SMS" android:textAllCaps="false" />
        <Button android:id="@+id/bluetoothBtn" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Bluetooth" android:textAllCaps="false" />
        <Button android:id="@+id/ttsBtn" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Text To Speech" android:textAllCaps="false" />
        <Button android:id="@+id/locationBtn" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="GPS / Location + Permissions" android:textAllCaps="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_blue" android:padding="14dp" android:text="Implemented: fragments, RecyclerView/ListView/GridView, AutoCompleteTextView, ProgressBar, CheckBox, RadioGroup, ToggleButton, Date/Time Picker, Firebase Auth + Realtime Database, intents, broadcast receiver, camera, SQLite, SMS, Bluetooth, TTS and GPS." android:textColor="@color/text_primary" android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
