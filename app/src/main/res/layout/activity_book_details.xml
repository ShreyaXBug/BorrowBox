<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="30dp">

        <!-- Back -->

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="35dp"
            android:text="‹  Back"
            android:textColor="#5F4960"
            android:textSize="17sp" />

        <!-- Book Cover -->

        <TextView
            android:layout_width="150dp"
            android:layout_height="190dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="25dp"
            android:background="#E9DDEB"
            android:gravity="center"
            android:text="BOOK&#10;COVER"
            android:textColor="#5F4960"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Book Title -->

        <TextView
            android:id="@+id/bookTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:text="The Alchemist"
            android:textColor="#29242B"
            android:textSize="27sp"
            android:textStyle="bold" />

        <!-- Author -->

        <TextView
            android:id="@+id/bookAuthor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="Paulo Coelho"
            android:textColor="#817681"
            android:textSize="16sp" />

        <!-- Category -->

        <TextView
            android:id="@+id/bookCategory"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:background="#E9DDEB"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Fiction"
            android:textColor="#5F4960"
            android:textStyle="bold" />

        <!-- Description Heading -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="30dp"
            android:text="About this book"
            android:textColor="#29242B"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Description -->

        <TextView
            android:id="@+id/bookDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="24dp"
            android:lineSpacingExtra="4dp"
            android:text="The Alchemist is a story about following your dreams, discovering your purpose and listening to your heart."
            android:textColor="#6F6870"
            android:textSize="15sp" />

        <!-- Owner -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="25dp"
            android:layout_marginEnd="24dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book Owner"
                android:textColor="#817681"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/bookOwner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Shared by Rahul"
                android:textColor="#29242B"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Borrow Button -->

        <Button
            android:id="@+id/borrowButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="25dp"
            android:layout_marginEnd="24dp"
            android:text="Borrow this Book"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</ScrollView>